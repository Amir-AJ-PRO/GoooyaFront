# ==================================
# Environment Variables - Production
# ==================================

# Node Environment
NODE_ENV=production

# Next.js Telemetry
NEXT_TELEMETRY_DISABLED=1

# Server Configuration
PORT=8030
HOSTNAME=0.0.0.0

# ==================================
# Backend API Configuration
# ==================================

# URL اصلی Backend API (Django)
NEXT_PUBLIC_API_URL=https://api.goooya.ir

# ==================================
# Authentication & Session
# ==================================

# زمان انقضای توکن‌ها در Backend (برای مستندسازی)
# ACCESS_TOKEN: 15 دقیقه
# REFRESH_TOKEN: 30 روز

# ==================================
# Security
# ==================================

# در production باید true باشه
SECURE_COOKIES=true

# ==================================
# Elasticsearch (اختیاری)
# ==================================

# ELASTICSEARCH_HOST=elasticsearch:9200
# ELASTICSEARCH_INDEX=properties

# ==================================
# Monitoring & Logging (اختیاری)
# ==================================

# SENTRY_DSN=your-sentry-dsn
# LOG_LEVEL=info
